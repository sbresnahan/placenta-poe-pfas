#!/bin/bash
# =============================================================================
# Stage 00 | reference_index.lsf
# Index the hg19 and GRCh38 FASTA files used by stage 01 (skips existing indexes).
# In : HG19_FASTA, HG38_FASTA, HG19_TO_HG38_CHAIN
# Out: <fasta>.fai
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"
use_conda "${SAMTOOLS_ENV}"

for fa in "${HG19_FASTA}" "${HG38_FASTA}"; do
  [[ -s "${fa}" ]] || { log "missing FASTA ${fa}"; exit 1; }
  if [[ ! -s "${fa}.fai" || "${fa}.fai" -ot "${fa}" ]]; then
    log "indexing ${fa}"; samtools faidx "${fa}"
  fi
done
[[ -s "${HG19_TO_HG38_CHAIN}" ]] || { log "missing chain ${HG19_TO_HG38_CHAIN}"; exit 1; }

receipt 00_reference_index
