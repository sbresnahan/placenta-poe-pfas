#!/bin/bash
# =============================================================================
# Stage 01 | check_mendel.lsf
# Mendelian-error QC of the GRCh38 trio genotypes (PLINK 1.9 --mendel).
# In : TRIO_VCF_HG38, TRIO_PED
# Out: merged/qc/GUSTO_trios.{bed,bim,fam}, merged/qc/GUSTO_trios_mendel.{mendel,imendel,fmendel,lmendel}
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"
QC=$(dirname "${TRIO_VCF_HG38}")/qc; mkdir -p "${QC}"
awk '{print $1, $2, $3, $4}' "${TRIO_PED}" > "${QC}/update_parents.txt"
awk '{print $1, $2, $5}'     "${TRIO_PED}" > "${QC}/update_sex.txt"

use_module "${PLINK_MODULE}"
plink --vcf "${TRIO_VCF_HG38}" --id-delim _ \
      --update-parents "${QC}/update_parents.txt" --update-sex "${QC}/update_sex.txt" \
      --make-bed --threads "${NCPU}" --out "${QC}/GUSTO_trios"
plink --bfile "${QC}/GUSTO_trios" --mendel --threads "${NCPU}" --out "${QC}/GUSTO_trios_mendel"

receipt 01_check_mendel
