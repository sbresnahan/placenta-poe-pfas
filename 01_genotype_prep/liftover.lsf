#!/bin/bash
# =============================================================================
# Stage 01 | liftover.lsf
# Drop sites invariant across all trio members, lift hg19 -> GRCh38
# (bcftools +liftover), sort, split/deduplicate records and keep biallelic SNPs
# whose REF matches GRCh38.
# In : TRIO_VCF_HG19, HG19_FASTA, HG38_FASTA, HG19_TO_HG38_CHAIN
# Out: TRIO_VCF_HG38 (+ .tbi)
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"
OUT_DIR=$(dirname "${TRIO_VCF_HG38}")
TMP=$(mktemp -d "${OUT_DIR}/tmp.liftover.XXXX"); trap 'rm -rf "${TMP}"' EXIT
use_bcftools

bcftools +fill-tags "${TRIO_VCF_HG19}" -Ou -- -t AC,AN \
  | bcftools view -i 'AC > 0 && AC < AN' -Ou \
  | BCFTOOLS_PLUGINS="$(dirname "${LIFTOVER_BCFTOOLS}")/plugins" "${LIFTOVER_BCFTOOLS}" +liftover -Ou -- \
      -s "${HG19_FASTA}" -f "${HG38_FASTA}" -c "${HG19_TO_HG38_CHAIN}" \
      --reject "${OUT_DIR}/liftover_rejected.bcf" \
  | bcftools sort -T "${TMP}" -Ou \
  | bcftools norm -m -any -d exact --check-ref x -f "${HG38_FASTA}" -Ou \
  | bcftools view -m2 -M2 -v snps --threads "${NCPU}" -Oz -o "${TRIO_VCF_HG38}"
bcftools index -f -t "${TRIO_VCF_HG38}"

log "GRCh38 sites: $(bcftools index -n "${TRIO_VCF_HG38}")"
receipt 01_liftover
