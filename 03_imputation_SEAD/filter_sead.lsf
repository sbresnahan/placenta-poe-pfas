#!/bin/bash
# =============================================================================
# Stage 03 | filter_sead.lsf      array: one element per (ancestry group x autosome)
# Keep biallelic imputed sites with MAF > 0.01 (the server applies Rsq >= 0.3).
# In : SEAD_DOWNLOAD_DIR/<group>_SEAD/chr<N>.SEAD.GRCh38.dose.vcf.gz
# Out: SEAD_DOWNLOAD_DIR/<group>_SEAD/chr<N>.biallelic.filtered.vcf.gz (+ .tbi)
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"
GROUP=$(group_of "${IDX}")
CHR=$(chr_of "${IDX}")
D="${SEAD_DOWNLOAD_DIR}/${GROUP}_SEAD"
use_bcftools

bcftools view --threads "${NCPU}" -m2 -M2 -i 'MAF[0] > 0.01' \
  -Oz -o "${D}/chr${CHR}.biallelic.filtered.vcf.gz" "${D}/chr${CHR}.SEAD.GRCh38.dose.vcf.gz"
bcftools index -f -t "${D}/chr${CHR}.biallelic.filtered.vcf.gz"

log "${GROUP} chr${CHR}: $(bcftools index -n "${D}/chr${CHR}.biallelic.filtered.vcf.gz") sites kept"
receipt 03_filter "${IDX}"
