#!/bin/bash
# =============================================================================
# Stage 04 | prep_transcriptome.lsf
# 1. INFANT_SAMPLES: VCF IDs (FID_IID) of the infants with placental RNA-seq,
#    i.e. infants whose FID is a SubjectID in INFANT_META_CSV.
# 2. TX_GTF_EXONS: the long-read transcriptome GTF with exon_number attributes
#    (numbered 5'->3' per transcript; required by Ornaments g2t conversion).
# In : ANCESTRY_DIR/samples_<group>.txt, INFANT_META_CSV, TX_GTF
# Out: INFANT_SAMPLES, TX_GTF_EXONS
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"

# ---- 1. RNA-seq infant list ----
mkdir -p "$(dirname "${INFANT_SAMPLES}")"
tail -n +2 "${INFANT_META_CSV}" | cut -d',' -f1 | tr -d '\r"' | sort -u > "${WORK_DIR}/rnaseq_subject_ids.txt"
cat "${ANCESTRY_DIR}"/samples_*.txt | tr -d '\r' | grep '_B' | sort -u \
  | awk -F'_' 'NR==FNR {keep[$1]; next} ($1 in keep)' "${WORK_DIR}/rnaseq_subject_ids.txt" - \
  > "${INFANT_SAMPLES}"
log "RNA-seq subjects: $(wc -l < "${WORK_DIR}/rnaseq_subject_ids.txt"); genotyped infants matched: $(wc -l < "${INFANT_SAMPLES}")"
[[ -s "${INFANT_SAMPLES}" ]]

# ---- 2. exon-numbered GTF ----
if [[ ! -s "${TX_GTF_EXONS}" ]]; then
  tmp_map=$(mktemp)
  # (transcript_id, start, end) -> exon number, ordered 5'->3' (descending start on minus strand)
  awk -F'\t' 'BEGIN{OFS="\t"}
    $3=="exon" && match($9, /transcript_id "[^"]+"/) {
      tid = substr($9, RSTART + 15, RLENGTH - 16)
      print tid, ($7=="-") ? -$4 : $4, $4, $5
    }' "${TX_GTF}" \
  | sort -k1,1 -k2,2n \
  | awk 'BEGIN{OFS="\t"} { n = ($1 != p) ? 1 : n + 1; p = $1; print $1, $3, $4, n }' > "${tmp_map}"

  awk -F'\t' -v OFS='\t' '
    NR==FNR { num[$1 FS $2 FS $3] = $4; next }
    $3=="exon" && match($9, /transcript_id "[^"]+"/) {
      k = substr($9, RSTART + 15, RLENGTH - 16) FS $4 FS $5
      if (k in num) $9 = ($9 ~ /;[[:space:]]*$/) ? $9 " exon_number \"" num[k] "\";" : $9 "; exon_number \"" num[k] "\";"
    }
    { print }' "${tmp_map}" "${TX_GTF}" > "${TX_GTF_EXONS}.tmp"
  mv "${TX_GTF_EXONS}.tmp" "${TX_GTF_EXONS}"
  rm -f "${tmp_map}"
  log "wrote ${TX_GTF_EXONS}"
fi

receipt 04_prep_tx
