#!/bin/bash
# =============================================================================
# Stage 07 | combine_baseline.lsf
# Gather batch results and apply BH within each level.
# In : BATCH_DIR/results/baseline_*.rds
# Out: MODEL_DIR/poe_nbmm_results_{gene,transcript}.rds
