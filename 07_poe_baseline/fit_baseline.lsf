#!/bin/bash
# =============================================================================
# Stage 07 | fit_baseline.lsf     array: N_BATCHES_GENE + N_BATCHES_TX elements
# Baseline NB-GLMM for every feature of one batch, NCPU features at a time.
# In : BATCH_DIR/<level>_batch_NNN.rds, MODEL_DIR/model_metadata.rds
# Out: BATCH_DIR/results/baseline_<level>_NNN.rds
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"
run_step_r 07_poe_baseline/fit_baseline.R
receipt 07_fit "${IDX}"
