#!/bin/bash
# =============================================================================
# Stage 07 | model_inputs.lsf
# Metadata + count matrices -> model inputs and per-batch long tables.
# In : POE_GENE_COUNTS, POE_TX_COUNTS, RNASEQ_COVARS_CSV, PFAS_*_CSV
# Out: MODEL_INPUTS, MODEL_DIR/model_metadata.rds, BATCH_DIR/<level>_batch_NNN.rds
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"
mkdir -p "${MODEL_DIR}" "${BATCH_DIR}/results"
run_step_r 07_poe_baseline/model_inputs.R
receipt 07_inputs
