#!/bin/bash
# =============================================================================
# Stage 08 | combine_interaction.lsf
# Gather batch results; BH within each level x condition.
# In : BATCH_DIR/results/interaction_*.rds
# Out: MODEL_DIR/poe_by_condition_<level>_<condition>.rds
