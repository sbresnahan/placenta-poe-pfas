#!/bin/bash
# =============================================================================
# Stage 09 | power.lsf
# Sample-size power curves from the baseline NB-GLMM standard errors
# (power_analysis.R) and the read-depth power figure (power_plot.R).
# In : MODEL_DIR/poe_nbmm_results_{transcript,gene}.rds
# Out: WORK_DIR/power_table_*.tsv, FIG_DIR/power_*.png
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"
run_step_r 09_power/power_analysis.R
run_step_r 09_power/power_plot.R
receipt 09_power
