#!/bin/bash
# =============================================================================
# Stage 10 | sim.lsf          array: SIM_N_RUNS elements (element r = seed r)
# One simulated study of the mediation analysis (PFAS_imprinting_sim.R).
# Out: SIM_DIR/run_<r>.RData
# =============================================================================
source "${REPO:?submit with run_pipeline.sh}/bin/job_env.sh"
mkdir -p "${SIM_DIR}"
run_step_r 10_mediation_sim/PFAS_imprinting_sim.R
receipt 10_sim "${IDX}"
